{
  "rules": {
    ".read": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')",
    ".write": "auth != null && auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2'",
    "menu_items": {
      ".read": true
    },
    "modifiers": {
      ".read": true
    },
    "categories": {
      ".read": true
    },
    "settings": {
      "online": {
        ".read": true
      }
    },
    "orders": {
      ".indexOn": [
        "timestamp"
      ],
      ".write": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')"
    },
    "tickets": {
      ".indexOn": [
        "timestamp"
      ],
      ".write": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')"
    },
    "customers": {
      ".write": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')"
    },
    "counters": {
      ".write": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')"
    },
    "inventory": {
      ".write": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')"
    },
    "counters_online": {
      "$day": {
        ".read": true,
        ".write": "$day.matches(/^[0-9]+$/) && $day.length === 6",
        ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
      }
    },
    "online_orders": {
      ".indexOn": [
        "createdAt",
        "status"
      ],
      ".write": "auth != null && (auth.uid === 'evCF6DozonfwBBDTW0nKuWE462u1' || auth.uid === 'jeQkVR9HTXcp8XtbDxCq0vVexLt2')",
      "$id": {
        ".write": "!data.exists() && newData.child('status').val() === 'new' && newData.child('createdAt').val() === now",
        ".validate": "$id.matches(/^[A-Z][A-Z][0-9]+-[A-Z][A-Z][A-Z]$/) && $id.length <= 20 && newData.hasChildren(['name','phone','items','total','status','createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[+][0-9]+$/) && newData.val().length >= 9 && newData.val().length <= 16"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
        }
      }
    }
  }
}